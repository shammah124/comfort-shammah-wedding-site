<!DOCTYPE html>
<html>
  <head>
    <title>CoSh2026</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      html, body { margin: 0; min-height: 100%; background: linear-gradient(160deg, #140f0b 0%, #0d0907 52%, #1a0e0e 100%); color: #f5f0e8; font-family: Georgia, serif; }
      .shell { min-height: 100vh; min-height: 100dvh; display: grid; grid-template-rows: auto 1fr auto; gap: 16px; padding: max(16px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); }
      .header, .footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
      .title { margin: 0; font-size: clamp(1.6rem, 4vw, 2.6rem); color: #e8d5b0; }
      .subtitle { margin: 4px 0 0; color: rgba(245,240,232,.72); }
      .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 16px; border-radius: 14px; background: linear-gradient(135deg, #c9a84c, #a8872a); color: #1a1410; text-decoration: none; font-weight: 700; }
      .frame { width: 100%; height: 100%; min-height: 70vh; border: 1px solid rgba(232,213,176,.16); border-radius: 20px; overflow: hidden; background: rgba(255,255,255,.04); }
      iframe { width: 100%; height: 100%; border: 0; background: #fff; }
      @media (max-width: 480px) { .header, .footer { align-items: flex-start; } .brand { align-items: flex-start; } .brand img { width: 44px; height: 44px; } .subtitle { font-size: .9rem; } .frame { min-height: 62dvh; border-radius: 14px; } }
    </style>
  </head>
  <body>
    <div class="shell">
      <div class="header">
        <div class="brand">
          <img src="/icon.png" alt="CoSh2026 logo">
          <div>
            <h1 class="title"><%= @title %></h1>
            <p class="subtitle"><%= @subtitle %></p>
          </div>
        </div>
        <a class="btn" href="<%= @download_path %>">Download</a>
      </div>
      <div class="frame">
        <iframe src="<%= @download_path %>" title="<%= @title %>"></iframe>
      </div>
      <div class="footer">
        <a class="btn" href="/">Back to launcher</a>
        <span>CoSh2026</span>
      </div>
    </div>
  </body>
</html>
